            [
                <font color="#336699">27/三月/25</font>

                            ]
            </font>

        </td></tr>
        <tr id="comment-body-445467"><td bgcolor="#ffffff">
            <div class="preformatted panel" style="border-width: 1px;"><div class="preformattedContent panelContent">
<pre> if [[ -z "$image_id" ]]; then
        echo "Upload deployment image"
        if [ ! -f "$image_path/$image_file" ]; then
            download_unzip_otafile
        fi
        openstack image create {{ $name }} \
        --disk-format {{ $opts.disk_format }} \
        --container-format {{ $opts.container_format }} \
        --file $image_path/$image_file \
        {{ if $opts.properties -}} {{ range $k, $v := $opts.properties }} --property {{$k}}={{$v}} {{ end }}{{ end -}} \
        --{{ $opts.visibility | default "public" }}
    else
        echo "Compare the md5 value of the deployed image"
        openstack_image_checksum=$(openstack image show $image_id -fvalue -cchecksum)
        if [[ $openstack_image_checksum != $ota_image_file_md5 ]]; then
            echo "Modify the glance image location information"
            if [ ! -f "$image_path/$image_file" ]; then
                download_unzip_otafile
            fi
            busybox=$(timeout 300s kubectl get pod -n openstack -o=custom-columns=NAME:.metadata.name,STATUS:.status.phase | grep busybox | grep -w Running | awk '{print $1}')
            location_url=$(openstack image show $image_id -fvalue -cproperties | egrep  'rbd://.*/compute/.*/snap' -o)
            image_ceph_uuid=$(echo ${ota_image_file_md5:0:8}-${ota_image_file_md5:8:4}-${ota_image_file_md5:12:4}-${ota_image_file_md5:16:4}-${ota_image_file_md5:20})
            set +e
            timeout 300s kubectl exec -it -n openstack $busybox -- rbd snap unprotect compute/$image_ceph_uuid@snap
            timeout 300s kubectl exec -it -n openstack $busybox -- rbd snap purge compute/$image_ceph_uuid
            timeout 300s kubectl exec -it -n openstack $busybox -- rbd rm compute/$image_ceph_uuid
            set -e
            timeout 300s kubectl exec -it -n openstack $busybox -- mkdir -p /host-tmp/$arch
            timeout 300s kubectl cp -n openstack $image_path/$image_file $busybox:/host-tmp/$arch
            timeout 600s kubectl exec -it -n openstack $busybox -- rbd import /host-tmp/$arch/$image_file compute/$image_ceph_uuid --image-format 2
            timeout 300s kubectl exec -it -n openstack $busybox -- rbd snap create compute/$image_ceph_uuid@snap
            timeout 300s kubectl exec -it -n openstack $busybox -- rbd snap protect compute/$image_ceph_uuid@snap
            ceph_fsid=$(timeout 300s kubectl exec -it -n openstack $busybox -- ceph -s | egrep '[0-9a-f]{8}-([0-9a-f]{4}-){3}[0-9a-f]{12}' -o)
            glance location-add --url rbd://$ceph_fsid/compute/$image_ceph_uuid/snap $image_id
            glance location-delete --url $location_url $image_id
            file_size=$(ls -l $image_path/$image_file | awk '{print $5}')
            openstack --os-image-api-version 1 image set --checksum $ota_image_file_md5 --size $file_size $image_id
        else
            echo "Keep the image in the environment unchanged"
        fi</pre>
</div></div>

<p>裸金属的方案，供参考</p>
        </td></tr>
