<p>以下类型的rip打栈均位于multi_cpu_stop函数的状态机循环中：</p>

<div class="preformatted panel" style="border-width: 1px;"><div class="preformattedContent panelContent">
<pre>0010:multi_cpu_stop+0x43/0xf0
0010:multi_cpu_stop+0x45/0xf0
0010:multi_cpu_stop+0x48/0xf0
0010:multi_cpu_stop+0x4a/0xf0
0010:multi_cpu_stop+0xaa/0xf0
0010:multi_cpu_stop+0xbb/0xf0
0010:rcu_momentary_dyntick_idle+0x0/0x40
0010:rcu_momentary_dyntick_idle+0x29/0x40
0010:rcu_momentary_dyntick_idle+0x2c/0x40
0010:rcu_momentary_dyntick_idle+0x5/0x40</pre>
</div></div>

<div class="code panel" style="border-width: 1px;"><div class="codeContent panelContent">
<pre class="code-c">182 <span class="code-comment">/* This is the cpu_stop function which stops the CPU. */</span>
183 <span class="code-keyword">static</span> <span class="code-keyword"><span class="code-object">int</span></span> multi_cpu_stop(<span class="code-keyword"><span class="code-object">void</span></span> *data)
184 {
185         <span class="code-keyword">struct</span> multi_stop_data *msdata = data;
186         <span class="code-keyword">enum</span> multi_stop_state newstate, curstate = MULTI_STOP_NONE;
187         <span class="code-keyword"><span class="code-object">int</span></span> cpu = smp_processor_id(), err = 0;
188         <span class="code-keyword"><span class="code-object">unsigned</span></span> <span class="code-keyword"><span class="code-object">long</span></span> flags;
189         <span class="code-keyword"><span class="code-object">bool</span></span> is_active;
190
191         /*
192         ¦* When called from stop_machine_from_inactive_cpu(), irq might
193         ¦* already be disabled.  Save the state <span class="code-keyword">and</span> restore it on exit.
194         ¦*/
195         local_save_flags(flags);
196
197         if (!msdata-&gt;active_cpus)
198                 is_active = cpu == cpumask_first(cpu_online_mask);  &lt;&lt;&lt;--- 如果active_cpus为null，当前cpu为所有在线cpu中的第一个cpu(通常情况下是cpu<span class="code-macro">#0)时，is_active为<span class="code-keyword">true</span>
</span>199         <span class="code-keyword">else</span>
200                 is_active = cpumask_test_cpu(cpu, msdata-&gt;active_cpus);  &lt;&lt;&lt;--- 按指定掩码判断当前cpu是否被指定了，如果被指定了，is_active为<span class="code-keyword">true</span>
201
202         <span class="code-comment">/* Simple state machine */</span>
203         <span class="code-keyword">do</span> {   <span class="code-quote-red">&lt;&lt;&lt;--- msdata-&gt;</span>state状态机循环
204                 <span class="code-comment">/* Chill out <span class="code-keyword">and</span> ensure we re-read multi_stop_state. */</span>
205                 cpu_relax_yield();
206                 newstate = READ_ONCE(msdata-&gt;state);
207                 if (newstate != curstate) {
208                         curstate = newstate;
209                         <span class="code-keyword">switch</span> (curstate) {
210                         <span class="code-keyword">case</span> MULTI_STOP_DISABLE_IRQ:
211                                 local_irq_disable();
212                                 hard_irq_disable();
213                                 <span class="code-keyword">break</span>;
214                         <span class="code-keyword">case</span> MULTI_STOP_RUN:
215                                 if (is_active)  &lt;&lt;&lt;--- 当active_cpus为null，只有cpu<span class="code-macro">#0执行fn；当active_cpus不为null，掩码指定的那些cpu会执行fn
</span>216                                         err = msdata-&gt;fn(msdata-&gt;data);
217                                 <span class="code-keyword">break</span>;
218                         <span class="code-keyword">default</span>:
219                                 <span class="code-keyword">break</span>;
220                         }
221                         ack_state(msdata);
222                 } <span class="code-keyword">else</span><span class="code-keyword"> if</span> (curstate &gt; MULTI_STOP_PREPARE) {
223                         /*
224                         ¦* At <span class="code-keyword">this</span> stage all other CPUs we depend on must spin
225                         ¦* in the same loop. Any reason <span class="code-keyword">for</span> hard-lockup should
226                         ¦* be detected <span class="code-keyword">and</span> reported on their side.
227                         ¦*/
228                         touch_nmi_watchdog();
229                 }
230                 rcu_momentary_dyntick_idle();  &lt;&lt;&lt;--- stop_machine执行时说明正在rcu静默状态，并进行上报
231         } <span class="code-keyword">while</span> (curstate != MULTI_STOP_EXIT);
232
233         local_irq_restore(flags);
234         <span class="code-keyword">return</span> err;
235 }</pre>
</div></div>

<p>is_active取值的反汇编：</p>

<div class="preformatted panel" style="border-width: 1px;"><div class="preformattedContent panelContent">
<pre>crash&gt; multi_stop_data -xo
struct multi_stop_data {
   [0x0] cpu_stop_fn_t fn;
   [0x8] void *data;
  [0x10] unsigned int num_threads;
  [0x18] const struct cpumask *active_cpus;
  [0x20] enum multi_stop_state state;
  [0x24] atomic_t thread_ack;
}
SIZE: 0x28

/usr/src/debug/kernel-4.18.0-147.5.1.el8_1/linux-4.18.0-147.5.1.es8_24.x86_64/kernel/stop_machine.c: 197
0xffffffff9736fac3 &lt;multi_cpu_stop+35&gt;: mov    0x18(%rdi),%rax  &lt;&lt;&lt;--- multi_stop_data-&gt;active_cpus
0xffffffff9736fac7 &lt;multi_cpu_stop+39&gt;: test   %rax,%rax
0xffffffff9736faca &lt;multi_cpu_stop+42&gt;: je     0xffffffff9736fb68 &lt;multi_cpu_stop+200&gt;
/usr/src/debug/kernel-4.18.0-147.5.1.el8_1/linux-4.18.0-147.5.1.es8_24.x86_64/./arch/x86/include/asm/bitops.h: 332
0xffffffff9736fad0 &lt;multi_cpu_stop+48&gt;: mov    %ebx,%ebx   &lt;&lt;&lt;--- %rbx为当前cpu
0xffffffff9736fad2 &lt;multi_cpu_stop+50&gt;: bt     %rbx,(%rax)  &lt;&lt;&lt;--- test当前cpu是否在掩码中
0xffffffff9736fad6 &lt;multi_cpu_stop+54&gt;: setb   %r15b   &lt;&lt;&lt;--- 是则将%r15最低一字节置为1
......
0xffffffff9736fb68 &lt;multi_cpu_stop+200&gt;:        mov    0x1295ba6(%rip),%esi        # 0xffffffff98605714 &lt;nr_cpu_ids&gt;
0xffffffff9736fb6e &lt;multi_cpu_stop+206&gt;:        mov    $0xffffffff98604ce0,%rdi
0xffffffff9736fb75 &lt;multi_cpu_stop+213&gt;:        call   0xffffffff976161b0 &lt;find_first_bit&gt;  &lt;&lt;&lt;--- 找online_mask中的第一个cpu，通常为cpu#0
/usr/src/debug/kernel-4.18.0-147.5.1.el8_1/linux-4.18.0-147.5.1.es8_24.x86_64/kernel/stop_machine.c: 198
0xffffffff9736fb7a &lt;multi_cpu_stop+218&gt;:        cmp    %eax,%ebx  &lt;&lt;&lt;--- 判断当前cpu是否为online_mask中的第一个cpu
0xffffffff9736fb7c &lt;multi_cpu_stop+220&gt;:        sete   %r15b   &lt;&lt;&lt;--- 是则将%r15最低一字节置为1
0xffffffff9736fb80 &lt;multi_cpu_stop+224&gt;:        jmp    0xffffffff9736fada &lt;multi_cpu_stop+58&gt;</pre>
</div></div>

<p>所以%r15的低8位为is_active，也就是0，当前cpu是36，无需执行fn，但是无法查看msdata-&gt;active_cpus，无法得知哪些cpu需要执行fn。</p>

<p>msdata-&gt;state状态机循环中switch分支的反汇编：</p>

<div class="preformatted panel" style="border-width: 1px;"><div class="preformattedContent panelContent">
<pre>/usr/src/debug/kernel-4.18.0-147.5.1.el8_1/linux-4.18.0-147.5.1.es8_24.x86_64/kernel/stop_machine.c: 207
0xffffffff9736fae8 &lt;multi_cpu_stop+72&gt;: cmp    %ebx,%eax
0xffffffff9736faea &lt;multi_cpu_stop+74&gt;: je     0xffffffff9736fb47 &lt;multi_cpu_stop+167&gt;
/usr/src/debug/kernel-4.18.0-147.5.1.el8_1/linux-4.18.0-147.5.1.es8_24.x86_64/kernel/stop_machine.c: 209
0xffffffff9736faec &lt;multi_cpu_stop+76&gt;: cmp    $0x2,%ebx
0xffffffff9736faef &lt;multi_cpu_stop+79&gt;: je     0xffffffff9736fb5f &lt;multi_cpu_stop+191&gt;
0xffffffff9736faf1 &lt;multi_cpu_stop+81&gt;: cmp    $0x3,%ebx
0xffffffff9736faf4 &lt;multi_cpu_stop+84&gt;: jne    0xffffffff9736fb0b &lt;multi_cpu_stop+107&gt;
/usr/src/debug/kernel-4.18.0-147.5.1.el8_1/linux-4.18.0-147.5.1.es8_24.x86_64/kernel/stop_machine.c: 215
0xffffffff9736faf6 &lt;multi_cpu_stop+86&gt;: test   %r15b,%r15b
0xffffffff9736faf9 &lt;multi_cpu_stop+89&gt;: je     0xffffffff9736fb0b &lt;multi_cpu_stop+107&gt;
/usr/src/debug/kernel-4.18.0-147.5.1.el8_1/linux-4.18.0-147.5.1.es8_24.x86_64/kernel/stop_machine.c: 216
0xffffffff9736fafb &lt;multi_cpu_stop+91&gt;: mov    0x8(%rbp),%rdi
0xffffffff9736faff &lt;multi_cpu_stop+95&gt;: mov    0x0(%rbp),%rax
0xffffffff9736fb03 &lt;multi_cpu_stop+99&gt;: call   0xffffffff97e011f0 &lt;__x86_indirect_thunk_rax&gt;</pre>
</div></div>

<p>可知%rbx为curstate，也就是1（MULTI_STOP_PREPARE）。状态枚举如下：</p>

<div class="preformatted panel" style="border-width: 1px;"><div class="preformattedContent panelContent">
<pre>141 /* This controls the threads on each CPU. */
142 enum multi_stop_state {
143         /* Dummy starting state for thread. */
144         MULTI_STOP_NONE,
145         /* Awaiting everyone to be scheduled. */
146         MULTI_STOP_PREPARE,
147         /* Disable interrupts. */
148         MULTI_STOP_DISABLE_IRQ,
149         /* Run the function */
150         MULTI_STOP_RUN,
151         /* Exit */
152         MULTI_STOP_EXIT,
153 };</pre>
</div></div>

<p>查看所有此类堆栈，情况都一样，is_active为false，curstate为MULTI_STOP_PREPARE，涉及的cpu有25、36、46、51、58、97、127。</p>

<p>状态的推进是通过每个cpu执行一次ack_state函数，将thread_ack（num_threads，也就是所有online的cpu个数）减至0，进入到set_state函数，重置thread_ack，并将msdata-&gt;state的枚举值加1：</p>

<div class="code panel" style="border-width: 1px;"><div class="codeContent panelContent">
<pre class="code-c">166 <span class="code-keyword">static</span> <span class="code-keyword"><span class="code-object">void</span></span> set_state(<span class="code-keyword">struct</span> multi_stop_data *msdata,
167                 ¦     <span class="code-keyword">enum</span> multi_stop_state newstate)
168 {
169         <span class="code-comment">/* Reset ack counter. */</span>
170         atomic_set(&amp;msdata-&gt;thread_ack, msdata-&gt;num_threads);
171         smp_wmb();
172         WRITE_ONCE(msdata-&gt;state, newstate);
173 }
174
175 <span class="code-comment">/* Last one to ack a state moves to the next state. */</span>
176 <span class="code-keyword">static</span> <span class="code-keyword"><span class="code-object">void</span></span> ack_state(<span class="code-keyword">struct</span> multi_stop_data *msdata)
177 {
178         if (atomic_dec_and_test(&amp;msdata-&gt;thread_ack))
179                 set_state(msdata, msdata-&gt;state + 1);
180 }</pre>
</div></div>

<p><b>当前的情况说明有cpu没有能及时执行ack_state，导致整个状态机无法推进。但是没有vmcore，无法分析是哪个cpu以及无法推进状态机的原因。</b></p>
        </td></tr>
